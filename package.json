{
  "name": "docforge",
  "displayName": "DocForge",
  "description": "AI-powered developer documentation and code explanation (scaffold).",
  "version": "0.0.1",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.78.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:docforge.hello",
    "onCommand:docforge.analyzeProject"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.78.0",
    "@types/node": "^18.16.0",
    "typescript": "^5.2.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "docforge.hello",
        "title": "DocForge: Hello"
      }
      ,
      {
        "command": "docforge.analyzeProject",
        "title": "DocForge: Analyze Project"
      }
    ]
  }
}